{
  "name": "lumovy-choice-awards",
  "version": "1.0.0",
  "private": true,
  "description": "Employee Choice Award voting portal",
  "scripts": {
    "postinstall": "npm --prefix server ci --omit=dev",
    "setup": "npm --prefix server install && npm --prefix web install",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server run start",
    "seed:demo": "npm --prefix server run seed:demo",
    "test": "npm --prefix server test"
  }
}
