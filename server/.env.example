# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
# Long random string; used to sign sessions and encrypt vote receipts. CHANGE IN PRODUCTION.
APP_SECRET=change-me-to-a-long-random-string

# Database: leave empty for SQLite (data/choice.db). For production use PostgreSQL:
# DATABASE_URL=postgres://user:pass@host:5432/choice
DATABASE_URL=

# File storage (local disk). Uploaded files are stored under this folder.
UPLOAD_DIR=./data/uploads

# Mail: "dev" captures emails in the admin Outbox (nothing is sent). "smtp" sends for real.
MAIL_TRANSPORT=dev
MAIL_FROM="Lumovy Choice Awards <choice-awards@lumovy.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# First HR admin, created on first start if no admin exists
BOOTSTRAP_ADMIN_EMAIL=hr@lumovy.com
BOOTSTRAP_ADMIN_NAME=HR Admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123
